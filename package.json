{
  "name": "ds-starter",
  "version": "0.0.0",
  "description": "Starter design system scaffold — React + TypeScript + Vite + Storybook + Style Dictionary.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/typography.css": "./src/styles/typography.css",
    "./styles/global.css": "./src/styles/global.css"
  },
  "files": [
    "dist",
    "src/styles/tokens.css",
    "src/styles/typography.css",
    "src/styles/global.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "dev": "pnpm tokens:sync && storybook dev -p 6060",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:watch": "node --watch-path=src/tokens/source scripts/build-tokens.mjs",
    "tokens:stories": "node scripts/build-token-stories.mjs",
    "tokens:stories:watch": "node scripts/build-token-stories.mjs --watch",
    "tokens:extract": "node scripts/figma-extract.mjs",
    "tokens:switch": "node scripts/switch-token-pipeline.mjs",
    "tokens:sync": "node scripts/wrap-theme.mjs && node scripts/build-token-stories.mjs",
    "tokens:sync:watch": "node scripts/wrap-theme.mjs --watch & node scripts/build-token-stories.mjs --watch",
    "theme:wrap": "node scripts/wrap-theme.mjs",
    "build": "pnpm tokens:build && vite build",
    "build:storybook": "pnpm tokens:sync && storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && pnpm lint:css",
    "lint:fix": "eslint . --fix && pnpm lint:css --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.3.5",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "storybook": "^10.3.5",
    "style-dictionary": "^5.4.0",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.18.0"
  }
}
